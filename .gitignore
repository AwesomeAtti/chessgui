# Secrets and local config — never tracked
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.keystore
credentials.json

# OS junk
.DS_Store
._*
Thumbs.db
desktop.ini

# FUSE orphans. The AI sandbox reaches this folder through a mount that cannot unlink an open
# file, so an in-place edit leaves the original inode behind as `.fuse_hidden*`. Harmless, but
# this repo is public and a blind `git add` would commit it.
.fuse_hidden*

# Editors / IDEs
.vscode/
.idea/
*.swp
*~

# Build output and dependencies (extend once the stack is chosen)
build/
dist/
out/
target/
bin/
obj/
node_modules/

# Tauri generated artefacts (schemas, mobile projects) — regenerated by the build
src-tauri/gen/

# Local databases and sample game data — may contain personal information
*.sqlite
*.sqlite3
*.db
local/
scratch/

# Chess engine binaries (large, platform-specific, licence-bearing)
engines/
